---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nis2ArchitectureBlueprint from '../components/Nis2ArchitectureBlueprint.astro';

const comparisons = await getCollection('comparisons');
const tools = await getCollection('tools');

const silos = [
  {
    code: 'EDR_XDR',
    name: 'EDR / XDR & Protection des Terminaux',
    nis2Ref: 'Art. 21.2.b & 21.2.g',
    description: 'Détection comportementale, confinement automatisé des rançongiciels et collecte de preuves forensiques sur les postes et serveurs.'
  },
  {
    code: 'SASE_VPN',
    name: 'SASE & Réseaux Zero Trust (ZTNA)',
    nis2Ref: 'Art. 21.2.i & 21.2.h',
    description: 'Micro-segmentation réseau, chiffrement des flux distants et remplacement des concentrateurs VPN exposés.'
  },
  {
    code: 'GRC_NIS2',
    name: 'Pilotage GRC & Conformité NIS2 / DORA',
    nis2Ref: 'Art. 21.2.a & 21.2.f',
    description: 'Gouvernance des risques cyber, alignement ANSSI / CCB CyberFundamentals et suivi continu des plans de remédiation.'
  },
  {
    code: 'IAM_PAM',
    name: 'Gestion des Identités & Comptes à Privilèges',
    nis2Ref: 'Art. 21.2.i & 21.2.j',
    description: 'Authentification multifacteur (MFA) matérielle, bastions d administration PAM et contrôle strict des accès tiers.'
  },
  {
    code: 'BACKUP_DR',
    name: 'Sauvegarde Immuable & Continuité (PRA/PCA)',
    nis2Ref: 'Art. 21.2.c',
    description: 'Sauvegardes immuables hors-ligne (Air-Gap), tests de restauration automatisés et maintien opérationnel en situation de crise.'
  },
  {
    code: 'VULN_PENTEST',
    name: 'Gestion des Vulnérabilités & Surface d Attaque',
    nis2Ref: 'Art. 21.2.e & 21.2.d',
    description: 'Scan continu des actifs exposés (EASM), priorisation des CVE critiques et audit de la chaîne d approvisionnement.'
  }
];

const indexSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'NIS2-STACK-HUB',
  description: 'Référentiel B2B d analyse technique, de qualification juridictionnelle et de calcul de TCO pour les solutions de cybersécurité conformes à la directive NIS2 (Article 21) et DORA.'
};

function formatShortJurisdiction(jStatus: string, country: string): string {
  if (jStatus === 'EU_MEMBER') return `Juridiction UE (${country})`;
  if (jStatus === 'ADEQUACY_RGPD_NON_EU') return `Hors UE · Adéquation RGPD (${country})`;
  return `Juridiction US · Cloud Act`;
}
---

<BaseLayout
  title="NIS2 // STACK HUB | Comparatifs Cyber B2B, Juridiction UE & Calculateur TCO"
  description="Référentiel indépendant d'analyse technique et tarifaire pour DSI, RSSI et PME/ETI soumis à la directive NIS2 (Article 21), au CCB CyberFundamentals et au règlement DORA."
  jsonLd={indexSchema}
>
  <section class="relative bg-white border-b border-zinc-200 py-14 sm:py-20 overflow-hidden">
    <div
      class="absolute inset-0 pointer-events-none bg-[linear-gradient(to_right,#e4e4e7_1px,transparent_1px),linear-gradient(to_bottom,#e4e4e7_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_80%_70%_at_50%_35%,#000_55%,transparent_100%)] opacity-65"
    ></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 animate-fade-up">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-zinc-100 text-zinc-800 border border-zinc-200 text-xs font-medium mb-6">
            <span>Référentiel d'Architecture Cyber B2B</span>
            <span class="font-mono text-emerald-700">//</span>
            <span>France (ANSSI) · Belgique (CCB) · Suisse</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-[2.65rem] font-display font-bold tracking-tight text-zinc-950 leading-[1.12] mb-5">
            Arbitrage Technologique, Juridiction UE et Calcul de TCO sous Directive NIS2
          </h1>

          <p class="text-sm sm:text-base text-zinc-600 leading-relaxed mb-7">
            Bâtissez votre pile de sécurité conforme à l'Article 21 de la directive (UE) 2022/2555 sans surcoût caché. Chaque logiciel est évalué sur sa juridiction exacte (Juridiction UE, Adéquation RGPD hors UE ou exposition US Cloud Act), ses certifications (ISO 27001, SOC 2, ANSSI) et ses relevés tarifaires publics indicatifs.
          </p>

          <div class="flex flex-wrap gap-3">
            <a
              href="#comparatifs"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded bg-zinc-900 hover:bg-zinc-800 text-white font-medium text-xs transition-colors"
            >
              <span>Consulter les Duels et Comparatifs</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
            <a
              href="/matrice-homologation-nis2.pdf"
              target="_blank"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded bg-white hover:bg-zinc-100 text-zinc-800 border border-zinc-200 text-xs font-medium transition-colors"
            >
              <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
              <span>Matrice de Conformité PDF</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-6">
          <Nis2ArchitectureBlueprint />
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-12 pt-8 border-t border-zinc-200 animate-fade-up-delay-2">
        <div class="bg-white/90 border border-zinc-200 rounded p-4">
          <p class="text-2xl font-bold font-mono text-zinc-950">{tools.length}</p>
          <p class="text-xs text-zinc-500 mt-0.5">Solutions B2B Évaluées</p>
        </div>
        <div class="bg-white/90 border border-zinc-200 rounded p-4">
          <p class="text-2xl font-bold font-mono text-emerald-700">
            {tools.filter((t) => t.data.jurisdictionStatus === 'EU_MEMBER').length} UE + {tools.filter((t) => t.data.jurisdictionStatus === 'ADEQUACY_RGPD_NON_EU').length} RGPD
          </p>
          <p class="text-xs text-zinc-500 mt-0.5">Hors Cloud Act US Direct</p>
        </div>
        <div class="bg-white/90 border border-zinc-200 rounded p-4">
          <p class="text-2xl font-bold font-mono text-zinc-950">{comparisons.length}</p>
          <p class="text-xs text-zinc-500 mt-0.5">Dossiers Comparatifs TCO</p>
        </div>
        <div class="bg-white/90 border border-zinc-200 rounded p-4">
          <p class="text-2xl font-bold font-mono text-zinc-950">6 / 6</p>
          <p class="text-xs text-zinc-500 mt-0.5">Silos Article 21 Couverts</p>
        </div>
      </div>
    </div>
  </section>

  <section id="comparatifs" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 pb-4 border-b border-zinc-200 gap-4">
      <div>
        <span class="text-xs uppercase tracking-wider text-zinc-500 font-semibold block">
          Dossiers d'Arbitrage Technique et Budgétaire
        </span>
        <h2 class="text-2xl font-display font-bold text-zinc-950 mt-1">
          Comparatifs et Duels d'Outils Conformes NIS2
        </h2>
      </div>
      <span class="text-xs text-zinc-500">
        Simulateur TCO interactif intégré dans chaque dossier
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {comparisons.map((comp) => {
        const compTools = comp.data.toolsCompared
          .map((slug) => tools.find((t) => t.data.slug === slug)?.data)
          .filter((t): t is NonNullable<typeof t> => Boolean(t));

        const hasEuMember = compTools.some((t) => t.jurisdictionStatus === 'EU_MEMBER');

        return (
          <article class="bg-white border border-zinc-200 hover:border-zinc-400 hover:-translate-y-0.5 hover:shadow-sm rounded-md p-6 flex flex-col justify-between transition-all duration-200 group">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="px-2.5 py-0.5 rounded bg-zinc-100 border border-zinc-200 text-zinc-800 font-mono text-[11px] font-medium">
                  {comp.data.category}
                </span>
                {hasEuMember && (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-medium">
                    <svg class="w-3 h-3 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Inclut Juridiction UE
                  </span>
                )}
              </div>

              <h3 class="text-lg font-display font-bold text-zinc-950 group-hover:text-zinc-700 transition-colors leading-snug mb-2.5">
                <a href={`/comparatifs/${comp.id}`} class="focus:outline-none">
                  {comp.data.title}
                </a>
              </h3>

              <p class="text-xs text-zinc-600 leading-relaxed mb-4">
                {comp.data.tldrVerdict}
              </p>

              <div class="bg-zinc-50 border border-zinc-200 rounded p-3 mb-4">
                <p class="text-[11px] uppercase text-zinc-500 font-semibold mb-2">
                  Solutions comparées :
                </p>
                <div class="flex flex-wrap gap-2">
                  {compTools.map((t) => (
                    <div class="inline-flex items-center gap-2 pr-2.5 pl-1 py-1 bg-white border border-zinc-200 rounded">
                      <div class="w-9 h-9 rounded bg-zinc-50 border border-zinc-200 p-1.5 shrink-0 flex items-center justify-center">
                        <img
                          src={`/logos/${t.slug}.svg`}
                          alt={`Logo ${t.name}`}
                          class="w-full h-full object-contain"
                          loading="lazy"
                        />
                      </div>
                      <div class="text-xs">
                        <span class="font-display font-bold text-zinc-900 block leading-tight">{t.name}</span>
                        <span class="text-[11px] text-zinc-500">
                          {formatShortJurisdiction(t.jurisdictionStatus, t.vendorCountry)}
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-zinc-200 flex items-center justify-between">
              <span class="text-xs text-zinc-500">
                Relevé le {comp.data.updatedDate}
              </span>
              <a
                href={`/comparatifs/${comp.id}`}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-900 group-hover:text-zinc-600"
              >
                <span>Ouvrir le Calculateur TCO</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section id="silos" class="bg-white border-y border-zinc-200 py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8 pb-4 border-b border-zinc-200 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <span class="text-xs uppercase tracking-wider text-zinc-500 font-semibold block">
            Cartographie Réglementaire Article 21
          </span>
          <h2 class="text-2xl font-display font-bold text-zinc-950 mt-1">
            Les 6 Silos Technologiques de Mise en Conformité NIS2
          </h2>
        </div>
        <span class="text-xs text-zinc-500">
          Alignement ANSSI · CCB CyberFundamentals · ISO/IEC 27001
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {silos.map((silo) => {
          const siloComparisons = comparisons.filter((c) => c.data.category === silo.code);
          const siloTools = tools.filter((t) => t.data.category === silo.code);

          return (
            <div
              id={`silo-${silo.code}`}
              class="bg-zinc-50/50 border border-zinc-200 hover:border-zinc-300 hover:-translate-y-0.5 hover:shadow-sm transition-all duration-200 rounded-md p-6 flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="px-2.5 py-0.5 rounded bg-white text-zinc-800 border border-zinc-200 font-mono text-xs font-medium">
                    {silo.code}
                  </span>
                  <span class="text-xs font-mono text-zinc-600">
                    {silo.nis2Ref}
                  </span>
                </div>

                <h3 class="text-base font-display font-bold text-zinc-950 mb-2">
                  {silo.name}
                </h3>

                <p class="text-xs text-zinc-600 leading-relaxed mb-4">
                  {silo.description}
                </p>
              </div>

              <div class="pt-3 border-t border-zinc-200">
                {siloComparisons.length > 0 ? (
                  <div class="space-y-1.5">
                    <p class="text-[11px] uppercase text-zinc-500 font-semibold">
                      Comparatifs disponibles ({siloTools.length} outils) :
                    </p>
                    {siloComparisons.map((sc) => (
                      <a
                        href={`/comparatifs/${sc.id}`}
                        class="flex items-center gap-1.5 text-xs font-medium text-zinc-900 hover:text-zinc-600 underline"
                      >
                        <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                        <span>{sc.data.title}</span>
                      </a>
                    ))}
                  </div>
                ) : (
                  <span class="text-xs text-zinc-400">
                    Analyse sectorielle en cours
                  </span>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section id="matrice-outils" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="mb-8 pb-4 border-b border-zinc-200 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <span class="text-xs uppercase tracking-wider text-zinc-500 font-semibold block">
          Base de Données Documentée
        </span>
        <h2 class="text-2xl font-display font-bold text-zinc-950 mt-1">
          Matrice Juridictionnelle et Tarification Indicative des Logiciels Évalués
        </h2>
      </div>
      <span class="text-xs text-zinc-500">
        Relevés tarifaires publics indicatifs HT sous preuve WebP
      </span>
    </div>

    <div class="overflow-x-auto bg-white border border-zinc-200 rounded-md">
      <table class="w-full text-left border-collapse text-xs sm:text-sm">
        <thead class="bg-zinc-100/80 text-zinc-700 text-xs uppercase border-b border-zinc-200">
          <tr>
            <th class="py-3.5 px-4 font-display font-semibold">Solution Logicielle</th>
            <th class="py-3.5 px-4 font-display font-semibold">Silo</th>
            <th class="py-3.5 px-4 font-display font-semibold">Statut Juridictionnel & Cloud Act</th>
            <th class="py-3.5 px-4 font-display font-semibold">Prix d'Entrée Indicatif HT</th>
            <th class="py-3.5 px-4 font-display font-semibold">Seuil Min.</th>
            <th class="py-3.5 px-4 font-display font-semibold">Certifications</th>
            <th class="py-3.5 px-4 font-display font-semibold text-right">Portail</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-200">
          {tools.map((tool) => (
            <tr class="hover:bg-zinc-50/80 transition-colors">
              <td class="py-3.5 px-4">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded bg-zinc-50 border border-zinc-200 p-1.5 shrink-0 flex items-center justify-center">
                    <img
                      src={`/logos/${tool.data.slug}.svg`}
                      alt={`Logo ${tool.data.name}`}
                      class="w-full h-full object-contain"
                      loading="lazy"
                    />
                  </div>
                  <div>
                    <span class="font-display font-bold text-zinc-950 block">
                      {tool.data.name}
                    </span>
                    <span class="text-[11px] text-zinc-500">{tool.data.vendorCountry}</span>
                  </div>
                </div>
              </td>
              <td class="py-3.5 px-4 font-mono text-xs text-zinc-600">
                {tool.data.category}
              </td>
              <td class="py-3.5 px-4">
                {tool.data.jurisdictionStatus === 'EU_MEMBER' && (
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-medium">
                    <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Juridiction UE · Hors Cloud Act direct
                  </span>
                )}
                {tool.data.jurisdictionStatus === 'ADEQUACY_RGPD_NON_EU' && (
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-zinc-100 text-zinc-800 border border-zinc-300 text-xs font-medium">
                    <svg class="w-3.5 h-3.5 text-zinc-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Hors UE · Adéquation RGPD ({tool.data.vendorCountry})
                  </span>
                )}
                {tool.data.jurisdictionStatus === 'US_CLOUD_ACT' && (
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-amber-50 text-amber-900 border border-amber-200 text-xs font-medium">
                    Juridiction US · Soumis Cloud Act
                  </span>
                )}
              </td>
              <td class="py-3.5 px-4 font-mono font-semibold text-zinc-950">
                {tool.data.pricingModel === 'CUSTOM_QUOTE' || tool.data.startingPriceMonthlyEur === 0
                  ? 'Sur devis'
                  : `${tool.data.startingPriceMonthlyEur.toFixed(2).replace('.', ',')} € / mois`}
              </td>
              <td class="py-3.5 px-4 text-xs text-zinc-600">
                <span class="font-mono">{tool.data.minimumSeats}</span> poste(s)
              </td>
              <td class="py-3.5 px-4">
                <div class="flex flex-wrap gap-1">
                  {tool.data.certifications.slice(0, 3).map((cert) => (
                    <span class="px-1.5 py-0.5 bg-zinc-50 border border-zinc-200 rounded text-[11px] text-zinc-700">
                      {cert}
                    </span>
                  ))}
                </div>
              </td>
              <td class="py-3.5 px-4 text-right">
                <a
                  href={`/go/${tool.data.slug}`}
                  target="_blank"
                  rel="nofollow noopener"
                  class="inline-flex items-center gap-1 px-3 py-1.5 rounded bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium transition-colors"
                >
                  <span>Offre</span>
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
