---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TcoCalculator, { type ToolItem } from '../../components/TcoCalculator.astro';

export async function getStaticPaths() {
  const comparisons = await getCollection('comparisons');
  const allTools = await getCollection('tools');

  return comparisons.map((comparison) => {
    const comparedTools: ToolItem[] = comparison.data.toolsCompared
      .map((slug) => allTools.find((t) => t.data.slug === slug)?.data)
      .filter((t): t is NonNullable<typeof t> => Boolean(t));

    const relatedComparisons = comparisons.filter(
      (c) => c.id !== comparison.id
    );

    return {
      params: { slug: comparison.id },
      props: {
        comparison,
        comparedTools,
        relatedComparisons
      }
    };
  });
}

const { comparison, comparedTools, relatedComparisons } = Astro.props;
const { Content } = await render(comparison);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: comparison.data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const softwareSchemas = comparedTools.map((tool) => ({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  applicationCategory: `SecurityApplication (${tool.category})`,
  operatingSystem: 'Windows, macOS, Linux, Cloud',
  offers: {
    '@type': 'Offer',
    price: tool.startingPriceMonthlyEur,
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: tool.officialUrl
  }
}));

const jsonLdPayload = [faqSchema, ...softwareSchemas];

const recommendedTool =
  comparedTools.find((t) => t.isEuropeanSovereign) || comparedTools[0];

const defaultWebhookUrl =
  import.meta.env.PUBLIC_LEAD_WEBHOOK_URL ||
  'https://discord.com/api/webhooks/1563575615163211947/mpNJSrQ9abu-3HvippJv6uuPsaRWNUuvXiugLnXBWUO-JiuzRzVVNhvkeDIbukHNwLGT';
---

<BaseLayout
  title={`${comparison.data.title} | Audit & TCO NIS2`}
  description={comparison.data.metaDescription}
  jsonLd={jsonLdPayload}
>
  <div class="relative bg-white border-b border-zinc-200 py-10 overflow-hidden">
    <div
      class="absolute inset-0 pointer-events-none bg-[linear-gradient(to_right,#e4e4e7_1px,transparent_1px),linear-gradient(to_bottom,#e4e4e7_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_80%_75%_at_50%_30%,#000_55%,transparent_100%)] opacity-60"
    ></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 animate-fade-up">
      <nav class="flex items-center gap-2 text-xs text-zinc-500 mb-4">
        <a href="/" class="hover:text-zinc-950 transition-colors">Accueil</a>
        <span>/</span>
        <a href="/#comparatifs" class="hover:text-zinc-950 transition-colors">Comparatifs B2B</a>
        <span>/</span>
        <span class="font-mono text-zinc-800">{comparison.data.category}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="px-2.5 py-0.5 rounded bg-zinc-100 text-zinc-800 border border-zinc-200 font-mono text-xs font-medium">
          {comparison.data.category}
        </span>
        <span class="px-2.5 py-0.5 rounded bg-white text-zinc-600 border border-zinc-200 text-xs">
          Audit mis à jour le {comparison.data.updatedDate}
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-medium">
          <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Preuves tarifaires vérifiées
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-display font-bold tracking-tight text-zinc-950 leading-tight mb-6">
        {comparison.data.title}
      </h1>

      <div class="bg-white border border-zinc-200 rounded-md overflow-hidden shadow-[0_1px_3px_rgba(9,9,11,0.03)]">
        <div class="bg-zinc-100/80 border-b border-zinc-200 px-5 py-3 flex flex-wrap items-center justify-between gap-2">
          <span class="text-xs font-display font-semibold uppercase tracking-wider text-zinc-800">
            Synthèse d'Audit Exécutive (BLUF — Bottom Line Up Front)
          </span>
          <span class="text-xs text-zinc-500">
            Périmètre : DSI, RSSI, PME et ETI (20 à 500 postes)
          </span>
        </div>
        <div class="p-5">
          <p class="text-sm sm:text-base text-zinc-800 leading-relaxed mb-4">
            {comparison.data.tldrVerdict}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-zinc-200 text-xs items-center">
            <div>
              <span class="text-zinc-500 block mb-1">Couverture réglementaire :</span>
              <strong class="font-mono text-zinc-900">{comparison.data.nis2ComplianceFocus}</strong>
            </div>
            <div>
              <span class="text-zinc-500 block mb-1.5">Solutions auditées :</span>
              <div class="flex flex-wrap items-center gap-2">
                {comparedTools.map((t) => (
                  <div class="inline-flex items-center gap-2 pr-2.5 pl-1 py-1 bg-zinc-50 border border-zinc-200 rounded">
                    <div class="w-9 h-9 rounded bg-white border border-zinc-200 p-1.5 shrink-0 flex items-center justify-center">
                      <img
                        src={`/logos/${t.slug}.svg`}
                        alt={`Logo ${t.name}`}
                        class="w-full h-full object-contain"
                      />
                    </div>
                    <strong class="font-display text-zinc-950 text-xs">{t.name}</strong>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    {recommendedTool && (
      <div class="bg-white rounded-md p-5 mb-8 border border-zinc-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 hover:border-zinc-300 transition-colors">
        <div class="flex items-start sm:items-center gap-3.5">
          <div class="w-9 h-9 rounded bg-zinc-50 border border-zinc-200 p-1.5 shrink-0 flex items-center justify-center">
            <img
              src={`/logos/${recommendedTool.slug}.svg`}
              alt={`Logo ${recommendedTool.name}`}
              class="w-full h-full object-contain"
            />
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-1">
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-semibold uppercase tracking-wider">
                <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Partenaire Recommandé NIS2
              </span>
              <span class="text-xs text-zinc-500">
                Juridiction : {recommendedTool.vendorCountry} ({recommendedTool.isEuropeanSovereign ? 'Exempt Cloud Act' : 'Standard International'})
              </span>
            </div>
            <p class="text-base font-display font-bold text-zinc-950">
              {recommendedTool.name} — Déploiement PME et ETI dès <span class="font-mono">{recommendedTool.minimumSeats}</span> poste(s)
            </p>
            <p class="text-xs text-zinc-600 mt-0.5">
              Certifications validées : {recommendedTool.certifications.join(' · ')}
            </p>
          </div>
        </div>
        <a
          href={`/go/${recommendedTool.slug}`}
          target="_blank"
          rel="nofollow noopener"
          class="shrink-0 inline-flex items-center gap-2 px-4 py-2.5 rounded bg-zinc-900 hover:bg-zinc-800 text-white font-medium text-xs transition-colors"
        >
          <span>Accéder à l'Offre {recommendedTool.name}</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    )}

    <TcoCalculator tools={comparedTools} />

    <section class="my-10 bg-white border border-zinc-200 rounded-md overflow-hidden">
      <div class="bg-zinc-100/80 border-b border-zinc-200 px-6 py-4 flex flex-wrap items-center justify-between gap-2">
        <div>
          <span class="text-xs uppercase tracking-wider text-zinc-500 font-semibold block">
            Audit de Souveraineté et Points Critiques
          </span>
          <h2 class="text-lg font-display font-bold text-zinc-950 mt-0.5">
            Fiches Synthétiques des Solutions Évaluées
          </h2>
        </div>
        <span class="text-xs font-mono text-zinc-600">
          Art. 21 Directive (UE) 2022/2555
        </span>
      </div>

      <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        {comparedTools.map((tool) => (
          <div class="border border-zinc-200 rounded-md p-5 bg-zinc-50/40 flex flex-col justify-between hover:-translate-y-0.5 hover:shadow-sm transition-all duration-200">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-9 h-9 rounded bg-white border border-zinc-200 p-1.5 shrink-0 flex items-center justify-center">
                    <img
                      src={`/logos/${tool.slug}.svg`}
                      alt={`Logo ${tool.name}`}
                      class="w-full h-full object-contain"
                      loading="lazy"
                    />
                  </div>
                  <h3 class="text-base font-display font-bold text-zinc-950">{tool.name}</h3>
                </div>
                {tool.isEuropeanSovereign ? (
                  <span class="px-2.5 py-0.5 rounded text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">
                    Souverain UE ({tool.vendorCountry})
                  </span>
                ) : (
                  <span class="px-2.5 py-0.5 rounded text-xs font-medium bg-amber-50 text-amber-900 border border-amber-200">
                    Juridiction {tool.vendorCountry}
                  </span>
                )}
              </div>

              <div class="mb-4">
                <p class="text-xs uppercase text-zinc-500 font-semibold mb-1.5">
                  Articles NIS2 couverts :
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {tool.nis2ArticlesCovered.map((art) => (
                    <span class="px-2 py-0.5 bg-white border border-zinc-200 rounded text-[11px] font-mono text-zinc-700">
                      {art}
                    </span>
                  ))}
                </div>
              </div>

              <div class="grid grid-cols-1 gap-3 mb-4 text-xs">
                <div class="bg-white border border-zinc-200 rounded p-3">
                  <p class="font-display font-semibold text-emerald-800 uppercase mb-1.5">
                    Points forts audités (+)
                  </p>
                  <ul class="space-y-1 text-zinc-700 list-disc pl-4">
                    {tool.pros.map((pro) => (
                      <li>{pro}</li>
                    ))}
                  </ul>
                </div>
                <div class="bg-white border border-zinc-200 rounded p-3">
                  <p class="font-display font-semibold text-rose-800 uppercase mb-1.5">
                    Points de vigilance (-)
                  </p>
                  <ul class="space-y-1 text-zinc-700 list-disc pl-4">
                    {tool.cons.map((con) => (
                      <li>{con}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <div class="pt-3 border-t border-zinc-200 flex items-center justify-between text-xs text-zinc-500">
              <span>Preuve tarifaire : {tool.lastVerifiedDate}</span>
              <a
                href={`/go/${tool.slug}`}
                target="_blank"
                rel="nofollow noopener"
                class="inline-flex items-center gap-1 text-zinc-900 hover:text-zinc-600 font-semibold underline"
              >
                <span>Portail officiel</span>
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <article class="bg-white border border-zinc-200 rounded-md p-6 sm:p-10 mdx-content">
      <Content />
    </article>

    <section class="my-10 bg-white border border-zinc-200 rounded-md overflow-hidden">
      <div class="bg-zinc-100/80 border-b border-zinc-200 px-6 py-4">
        <span class="text-xs uppercase tracking-wider text-zinc-500 font-semibold block">
          Questions Fréquentes des DSI et RSSI (Schema.org FAQPage)
        </span>
        <h2 class="text-lg font-display font-bold text-zinc-950 mt-0.5">
          Clarifications Réglementaires et Techniques
        </h2>
      </div>

      <div class="p-6 space-y-4">
        {comparison.data.faq.map((item) => (
          <div class="border border-zinc-200 rounded p-5 bg-zinc-50/50">
            <h3 class="text-sm font-display font-bold text-zinc-950 mb-2">
              {item.question}
            </h3>
            <p class="text-sm text-zinc-700 leading-relaxed">
              {item.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section
      id="capture-devis"
      class="my-10 bg-white border border-zinc-200 rounded-md overflow-hidden"
    >
      <div class="bg-zinc-100/80 border-b border-zinc-200 px-6 py-3 flex items-center justify-between">
        <span class="text-xs font-display font-semibold uppercase tracking-wider text-zinc-800">
          Cellule d'Accompagnement Achats B2B (20 à 500 postes)
        </span>
        <span class="font-mono text-xs text-zinc-500">Art. 21 NIS2 / DORA</span>
      </div>
      <div class="p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-3 gap-6 items-center">
        <div class="lg:col-span-2">
          <h2 class="text-xl font-display font-bold text-zinc-950 mb-2">
            Recevoir la Matrice d'Homologation NIS2 (PDF) et Devis Groupé
          </h2>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Obtenez le dossier complet de conformité Article 21 (cartographie ANSSI et CCB CyberFundamentals, comparatif TCO sur 36 mois et clauses de réversibilité) pour présenter votre arbitrage en comité de direction.
          </p>
        </div>
        <div class="bg-zinc-50 p-5 rounded border border-zinc-200">
          <form
            class="space-y-3"
            data-lead-form
            data-silo={comparison.data.category}
            data-slug={comparison.id}
            data-webhook-url={defaultWebhookUrl}
          >
            <div>
              <label for="lead-email" class="block text-xs font-medium text-zinc-700 mb-1">
                Email Professionnel (DSI / RSSI / Direction)
              </label>
              <input
                id="lead-email"
                type="email"
                required
                placeholder="prenom.nom@entreprise.fr"
                class="w-full px-3 py-2 rounded bg-white border border-zinc-200 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900"
              />
            </div>
            <div class="grid grid-cols-2 gap-2.5">
              <div>
                <label for="lead-tool" class="block text-xs font-medium text-zinc-700 mb-1">
                  Solution évaluée
                </label>
                <input
                  id="lead-tool"
                  type="text"
                  value={recommendedTool ? recommendedTool.name : comparison.data.category}
                  class="w-full px-3 py-2 rounded bg-white border border-zinc-200 text-xs font-medium text-zinc-900 focus:outline-none focus:border-zinc-900"
                />
              </div>
              <div>
                <label for="lead-seats" class="block text-xs font-medium text-zinc-700 mb-1">
                  Volume du parc
                </label>
                <input
                  id="lead-seats"
                  type="text"
                  value="50 postes"
                  class="w-full px-3 py-2 rounded bg-white border border-zinc-200 text-xs font-mono text-zinc-900 focus:outline-none focus:border-zinc-900"
                />
              </div>
            </div>
            <button
              type="submit"
              class="w-full py-2.5 px-4 rounded bg-zinc-900 hover:bg-zinc-800 text-white font-medium text-xs transition-colors cursor-pointer"
            >
              Télécharger la Matrice PDF (Article 21)
            </button>
            <p data-form-msg class="hidden text-xs text-emerald-700 font-medium text-center pt-1">
              Téléchargement de la Matrice PDF lancé.
            </p>
          </form>
        </div>
      </div>
    </section>

    {relatedComparisons.length > 0 && (
      <section class="my-10">
        <h2 class="text-base font-display font-bold text-zinc-950 mb-4 uppercase tracking-wider">
          Autres Comparatifs et Audits d'Architecture NIS2
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {relatedComparisons.map((rel) => (
            <a
              href={`/comparatifs/${rel.id}`}
              class="block bg-white border border-zinc-200 hover:border-zinc-400 hover:-translate-y-0.5 hover:shadow-sm rounded-md p-5 transition-all duration-200 group"
            >
              <div class="flex items-center justify-between text-xs text-zinc-500 mb-2">
                <span class="px-2 py-0.5 bg-zinc-100 border border-zinc-200 text-zinc-800 rounded font-mono font-medium">
                  {rel.data.category}
                </span>
                <span>Mis à jour le {rel.data.updatedDate}</span>
              </div>
              <h3 class="text-base font-display font-bold text-zinc-950 group-hover:text-zinc-700 transition-colors mb-1.5">
                {rel.data.title}
              </h3>
              <p class="text-xs text-zinc-600 line-clamp-2">
                {rel.data.metaDescription}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <script>
    function initLeadForms() {
      const leadForms = document.querySelectorAll('[data-lead-form]');
      leadForms.forEach((formEl) => {
        const form = formEl as HTMLFormElement;
        if (form.dataset.bound === 'true') {
          return;
        }
        form.dataset.bound = 'true';

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const emailInput = form.querySelector('#lead-email') as HTMLInputElement | null;
          const toolInput = form.querySelector('#lead-tool') as HTMLInputElement | null;
          const seatsInput = form.querySelector('#lead-seats') as HTMLInputElement | null;
          const msg = form.querySelector('[data-form-msg]');

          const email = emailInput ? emailInput.value.trim() : '';
          const tool = toolInput ? toolInput.value.trim() : '';
          const seats = seatsInput ? seatsInput.value.trim() : '50 postes';
          const silo = form.dataset.silo || '';
          const sourceUrl = window.location.href;

          const payload = {
            email,
            tool,
            seats,
            silo,
            sourceUrl,
            content: `[NOUVEAU LEAD B2B NIS2] Email: ${email} | Outil: ${tool} | Parc: ${seats} | Silo: ${silo} | Source: ${sourceUrl}`
          };

          try {
            const existing = JSON.parse(localStorage.getItem('nis2_b2b_leads') || '[]');
            existing.push(payload);
            localStorage.setItem('nis2_b2b_leads', JSON.stringify(existing));
          } catch {}

          const webhookUrl = form.dataset.webhookUrl || '';
          if (webhookUrl) {
            try {
              await fetch(webhookUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });
            } catch {}
          }

          if (msg) {
            msg.classList.remove('hidden');
          }

          const link = document.createElement('a');
          link.href = '/matrice-homologation-nis2.pdf';
          link.download = 'Matrice-Homologation-NIS2-Article21.pdf';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        });
      });
    }

    initLeadForms();
    document.addEventListener('astro:page-load', initLeadForms);
  </script>
</BaseLayout>
