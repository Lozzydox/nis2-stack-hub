---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({
    params: { slug: tool.data.slug },
    props: { tool: tool.data }
  }));
}

const { tool } = Astro.props;

const isCustomQuote = tool.pricingModel === 'CUSTOM_QUOTE' || tool.startingPriceMonthlyEur === 0;

function formatJurisdictionDetail(jStatus: string, country: string): string {
  if (jStatus === 'EU_MEMBER') {
    return `Juridiction UE (${country}) · Hors Cloud Act direct`;
  }
  if (jStatus === 'ADEQUACY_RGPD_NON_EU') {
    return `Hors UE · Adéquation RGPD (${country})`;
  }
  return `Juridiction US (${country}) · Soumis Cloud Act`;
}
---

<BaseLayout
  title={`Obtention des Grilles Tarifaires & Chiffrage B2B — ${tool.name} | NIS2 // STACK HUB`}
  description={`Dossier d'évaluation NIS2 (Article 21) et chiffrage B2B pour ${tool.name}. Téléchargez la matrice PDF et consultez les relevés tarifaires.`}
>
  {tool.hasActiveAffiliateLink && (
    <script is:inline define:vars={{ targetUrl: tool.affiliateUrl }}>
      window.location.replace(targetUrl);
    </script>
  )}

  <section class="relative py-12 sm:py-16 overflow-hidden">
    <div
      class="absolute inset-0 pointer-events-none bg-[linear-gradient(to_right,#e4e4e7_1px,transparent_1px),linear-gradient(to_bottom,#e4e4e7_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_75%_70%_at_50%_35%,#000_50%,transparent_100%)] opacity-60"
    ></div>

    <div class="relative max-w-2xl mx-auto px-4 sm:px-6">
      <div class="bg-white border border-zinc-200 rounded-md overflow-hidden shadow-[0_2px_12px_rgba(9,9,11,0.04)] animate-fade-up">
        <div class="bg-zinc-100/80 border-b border-zinc-200 px-6 py-3.5 flex flex-wrap items-center justify-between gap-2">
          <span class="font-mono text-[11px] font-semibold px-2 py-0.5 rounded bg-white text-zinc-800 border border-zinc-200">
            CELLULE D'ÉVALUATION B2B // {tool.category}
          </span>
          <span class="text-xs text-zinc-500">
            Relevé le {tool.lastVerifiedDate}
          </span>
        </div>

        <div class="p-6 sm:p-8">
          <div class="flex items-start gap-4 mb-6">
            <div class="w-12 h-12 rounded bg-zinc-50 border border-zinc-200 p-2 shrink-0 flex items-center justify-center">
              <img
                src={`/logos/${tool.slug}.svg`}
                alt={`Logo ${tool.name}`}
                class="w-full h-full object-contain"
              />
            </div>
            <div>
              <h1 class="text-xl sm:text-2xl font-display font-bold tracking-tight text-zinc-950 leading-snug">
                Obtention des Grilles Tarifaires & Chiffrage B2B — {tool.name}
              </h1>
              <p class="text-xs text-zinc-600 mt-1">
                {formatJurisdictionDetail(tool.jurisdictionStatus, tool.vendorCountry)} · Seuil min. : <span class="font-mono">{tool.minimumSeats}</span> poste(s)
              </p>
            </div>
          </div>

          <div class="bg-zinc-50 border border-zinc-200 rounded p-4 mb-6 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div>
              <span class="text-zinc-500 block mb-0.5">Relevé tarifaire public indicatif :</span>
              <strong class="font-mono text-sm text-zinc-950">
                {isCustomQuote
                  ? 'Sur devis entreprise (PME / ETI)'
                  : `${tool.startingPriceMonthlyEur.toFixed(2).replace('.', ',')} € HT / mois`}
              </strong>
            </div>
            <div>
              <span class="text-zinc-500 block mb-0.5">Couverture Article 21 NIS2 :</span>
              <strong class="font-mono text-zinc-900">
                {tool.nis2ArticlesCovered.join(' · ')}
              </strong>
            </div>
          </div>

          <p class="text-sm text-zinc-600 leading-relaxed mb-6">
            Indiquez votre adresse professionnelle et le volume de votre parc informatique pour télécharger immédiatement la <strong>Matrice d'Évaluation Technique & Financière NIS2 (PDF)</strong> incluant les barèmes comparatifs de <strong>{tool.name}</strong>.
          </p>

          <form
            class="space-y-4 bg-zinc-50/70 border border-zinc-200 rounded p-5"
            data-broker-lead-form
            data-tool={tool.name}
            data-silo={tool.category}
          >
            <div class="hidden" aria-hidden="true">
              <label for="broker-website-url">Website</label>
              <input
                id="broker-website-url"
                name="website_url"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div>
              <label for="broker-email" class="block text-xs font-medium text-zinc-800 mb-1.5">
                Email Professionnel (DSI / RSSI / Achats IT)
              </label>
              <input
                id="broker-email"
                type="email"
                required
                placeholder="prenom.nom@entreprise.fr"
                class="w-full px-3.5 py-2.5 rounded bg-white border border-zinc-200 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900"
              />
            </div>

            <div>
              <label for="broker-seats" class="block text-xs font-medium text-zinc-800 mb-1.5">
                Volume de postes / licences à couvrir
              </label>
              <select
                id="broker-seats"
                class="w-full px-3.5 py-2.5 rounded bg-white border border-zinc-200 text-sm font-mono text-zinc-900 focus:outline-none focus:border-zinc-900"
              >
                <option value="10 à 25 postes">10 à 25 postes (TPE)</option>
                <option value="25 à 50 postes" selected>25 à 50 postes (PME)</option>
                <option value="50 à 150 postes">50 à 150 postes (PME / Entité Importante)</option>
                <option value="150 à 300 postes">150 à 300 postes (ETI)</option>
                <option value="300 à 500+ postes">300 à 500+ postes (Entité Essentielle)</option>
              </select>
            </div>

            <div class="space-y-2.5 pt-1">
              <label class="flex items-start gap-2.5 text-xs text-zinc-700 cursor-pointer">
                <input
                  id="broker-consent-privacy"
                  type="checkbox"
                  required
                  class="mt-0.5 w-3.5 h-3.5 accent-zinc-900 rounded shrink-0 cursor-pointer"
                />
                <span>
                  J'accepte que mon adresse email soit traitée pour recevoir la matrice PDF conformément à la <a href="/confidentialite" class="underline font-medium text-zinc-900">Politique de Confidentialité</a>. *
                </span>
              </label>

              <label class="flex items-start gap-2.5 text-xs text-zinc-600 cursor-pointer">
                <input
                  id="broker-consent-partner"
                  type="checkbox"
                  class="mt-0.5 w-3.5 h-3.5 accent-zinc-900 rounded shrink-0 cursor-pointer"
                />
                <span>
                  Je souhaite être mis en relation avec un intégrateur ou éditeur partenaire pour obtenir un chiffrage personnalisé (optionnel).
                </span>
              </label>
            </div>

            <button
              type="submit"
              class="w-full py-3 px-4 rounded bg-zinc-900 hover:bg-zinc-800 text-white font-medium text-xs transition-colors cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Télécharger la Grille Indicative & Matrice PDF</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </button>

            <div
              data-broker-msg
              class="hidden p-3 rounded bg-emerald-50 border border-emerald-200 text-xs text-emerald-900 font-medium text-center"
            >
              Votre demande est enregistrée et le téléchargement de la Matrice PDF NIS2 a démarré.
            </div>
          </form>

          <div class="mt-6 pt-5 border-t border-zinc-200 text-center">
            <a
              href={tool.officialUrl}
              rel="nofollow noopener"
              class="inline-flex items-center gap-1.5 text-xs text-zinc-500 hover:text-zinc-900 underline transition-colors"
            >
              <span>Continuer vers le portail officiel de l'éditeur sans accompagnement</span>
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    function initBrokerForms() {
      const forms = document.querySelectorAll('[data-broker-lead-form]');
      forms.forEach((formEl) => {
        const form = formEl as HTMLFormElement;
        if (form.dataset.bound === 'true') {
          return;
        }
        form.dataset.bound = 'true';

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const emailInput = form.querySelector('#broker-email') as HTMLInputElement | null;
          const seatsInput = form.querySelector('#broker-seats') as HTMLSelectElement | null;
          const honeypotInput = form.querySelector('#broker-website-url') as HTMLInputElement | null;
          const privacyInput = form.querySelector('#broker-consent-privacy') as HTMLInputElement | null;
          const partnerInput = form.querySelector('#broker-consent-partner') as HTMLInputElement | null;
          const msg = form.querySelector('[data-broker-msg]');

          const payload = {
            email: emailInput ? emailInput.value.trim() : '',
            tool: form.dataset.tool || '',
            seats: seatsInput ? seatsInput.value : '25 à 50 postes',
            silo: form.dataset.silo || '',
            sourceUrl: window.location.href,
            website_url: honeypotInput ? honeypotInput.value : '',
            consentPrivacy: privacyInput ? privacyInput.checked : false,
            consentPartnerShare: partnerInput ? partnerInput.checked : false
          };

          try {
            await fetch('/api/lead', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
          } catch {}

          if (msg) {
            msg.classList.remove('hidden');
          }

          const link = document.createElement('a');
          link.href = '/matrice-homologation-nis2.pdf';
          link.download = 'Matrice-Conformite-NIS2-Article21.pdf';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        });
      });
    }

    initBrokerForms();
    document.addEventListener('astro:page-load', initBrokerForms);
  </script>
</BaseLayout>
