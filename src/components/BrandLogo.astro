---
interface Props {
  size?: 'sm' | 'md';
  showSubtitle?: boolean;
}

const { size = 'md', showSubtitle = true } = Astro.props;
const iconDimensions = size === 'sm' ? 'w-7 h-7' : 'w-9 h-9';
const titleSize = size === 'sm' ? 'text-xs' : 'text-sm';
---

<div class="inline-flex items-center gap-3 select-none">
  <div class={`${iconDimensions} rounded bg-white border border-zinc-200 flex items-center justify-center shrink-0 shadow-[0_1px_2px_rgba(9,9,11,0.04)]`}>
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M12 2.5L20.5 7.25V16.75L12 21.5L3.5 16.75V7.25L12 2.5Z"
        stroke="#09090B"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <path
        d="M12 2.5V12M12 12L20.5 7.25M12 12L3.5 7.25M12 12V21.5"
        stroke="#09090B"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M7.75 9.625L12 12L16.25 9.625V14.375L12 16.75L7.75 14.375V9.625Z"
        fill="#FAFAFA"
        stroke="#09090B"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <rect x="10.25" y="10.25" width="3.5" height="3.5" rx="0.75" fill="#059669" />
    </svg>
  </div>
  <div class="flex flex-col">
    <div class={`font-display font-bold tracking-tight text-zinc-950 leading-none flex items-center gap-1.5 ${titleSize}`}>
      <span>NIS2</span>
      <span class="font-mono text-emerald-700 font-semibold text-xs">//</span>
      <span>STACK HUB</span>
    </div>
    {showSubtitle && (
      <span class="text-[11px] text-zinc-500 leading-none mt-1 font-normal">
        Observatoire Cyber B2B & TCO
      </span>
    )}
  </div>
</div>
